SCHOOL_NOTIFY_DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/school_notify
SCHOOL_NOTIFY_REDIS_URL=redis://127.0.0.1:6379/0
SCHOOL_NOTIFY_REDIS_PASSWORD=your_redis_password
SCHOOL_NOTIFY_REDIS_KEY_PREFIX=school-notify
SCHOOL_NOTIFY_AUTH_SESSION_CACHE_TTL_SECONDS=7200
SCHOOL_NOTIFY_DEVICE_ONLINE_TTL_SECONDS=90
SCHOOL_NOTIFY_SQL_ECHO=false
SCHOOL_NOTIFY_WECHAT_APP_ID=your_wechat_app_id
SCHOOL_NOTIFY_WECHAT_APP_SECRET=your_wechat_app_secret
SCHOOL_NOTIFY_SESSION_SIGNING_SECRET=replace_with_random_secret
