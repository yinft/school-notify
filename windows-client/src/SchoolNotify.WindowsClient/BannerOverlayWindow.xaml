<Window x:Class="SchoolNotify.WindowsClient.BannerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Top="0"
        Left="0"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        Height="64"
        Background="Transparent"
        Visibility="Collapsed">
    <Grid x:Name="BannerViewport" ClipToBounds="True" Margin="0">
        <Border x:Name="BannerBorder" CornerRadius="0" Padding="0">
            <TextBlock x:Name="MarqueeTextBlock"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       Text=""
                       TextWrapping="NoWrap">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="MarqueeTransform" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Border>
    </Grid>
</Window>
