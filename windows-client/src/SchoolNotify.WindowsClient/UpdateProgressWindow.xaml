<Window x:Class="SchoolNotify.WindowsClient.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在升级"
        Width="380"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Background="#0F172A" CornerRadius="16" Padding="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Viewbox Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                <ProgressBar IsIndeterminate="True"
                             Width="40"
                             Height="40"
                             Foreground="#38BDF8"
                             Background="#1E293B" />
            </Viewbox>
            <TextBlock Text="正在升级，请稍候..."
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock Text="升级完成后窗口将自动重新打开"
                       FontSize="13"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
