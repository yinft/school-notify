<Window x:Class="SchoolNotify.WindowsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="School Notify Client"
        Height="680"
        Width="980"
        Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="ChoicePillRadioButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#0F172A" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#0F172A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20" Background="#0F172A" CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="White" Text="校园通知屏客户端" />
                    <TextBlock x:Name="StatusSummaryTextBlock" Margin="0,8,0,0" Foreground="#CBD5E1" Text="正在初始化客户端..." TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="128"
                        Padding="18,10"
                        VerticalAlignment="Top"
                        Background="#38BDF8"
                        BorderBrush="#7DD3FC"
                        Foreground="#082F49"
                        FontWeight="Bold"
                        Content="⚙ 通知设置"
                        Click="SettingsButtonClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="设备信息" />
                    <TextBlock x:Name="DeviceNameTextBlock" Margin="0,12,0,0" Text="设备名称：-" />
                    <TextBlock x:Name="DeviceIdTextBlock" Margin="0,8,0,0" Text="设备 ID：-" />
                    <TextBlock x:Name="ConnectionStatusTextBlock" Margin="0,8,0,0" Foreground="#475569" Text="连接状态：未连接" />
                    <TextBlock x:Name="LastHeartbeatTextBlock" Margin="0,8,0,0" Text="最后心跳：-" />
                    <TextBlock x:Name="ReconnectStatusTextBlock" Margin="0,8,0,0" Text="重连状态：未启动" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="绑定信息" />
                    <TextBlock x:Name="BindingCodeTextBlock" Margin="0,12,0,0" FontSize="32" FontWeight="Bold" Foreground="#0F172A" Text="绑定码：-" />
                    <TextBlock x:Name="BindingCodeCountdownTextBlock" Margin="0,8,0,0" Foreground="#475569" Text="二维码有效期：-" />
                    <Button Margin="0,12,0,0" Padding="12,8" Background="#E0F2FE" BorderBrush="#7DD3FC" Foreground="#075985" FontWeight="SemiBold" Content="刷新二维码" Click="RefreshBindingCodeButtonClicked" />
                    <TextBlock x:Name="BindingPayloadTextBlock" Visibility="Collapsed" Margin="0,8,0,0" Foreground="#475569" Text="扫码内容：-" TextWrapping="Wrap" />
                    <Border Width="180" Height="180" Margin="0,16,0,0" Background="#E2E8F0" CornerRadius="12">
                        <Image x:Name="QrImage" Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="客户端说明" />
                    <TextBlock Margin="0,12,0,0" Text="1. 在线状态使用中文和颜色标识" />
                    <TextBlock Margin="0,6,0,0" Text="2. 绑定码和二维码用于小程序绑定" />
                    <TextBlock Margin="0,6,0,0" Text="3. 通知显示方式可在右侧设置" />
                    <TextBlock Margin="0,6,0,0" Text="4. 时间按北京时间显示" />
                </StackPanel>
            </Border>

            <Border x:Name="SettingsPanel" Grid.Column="2" Padding="0" Background="White" CornerRadius="18" BorderBrush="#BAE6FD" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="18" Background="#E0F2FE" CornerRadius="18,18,0,0">
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#075985" Text="通知显示设置" />
                                <TextBlock Margin="0,6,0,0" Foreground="#0C4A6E" Text="控制开机自启、通知位置、颜色与停留时间。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="18">
                            <Border Padding="14" Background="#F8FAFC" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="基础设置" />
                                    <CheckBox x:Name="AutoStartCheckBox" Margin="0,12,0,0" Content="开机自动启动（推荐开启）" IsChecked="True" Checked="ClientSettingsControlChanged" Unchecked="ClientSettingsControlChanged" />

                                    <TextBlock Margin="0,14,0,0" Foreground="#334155" FontWeight="SemiBold" Text="通知显示方式" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton x:Name="DisplayModeTopBannerRadioButton" GroupName="DisplayMode" Tag="TopBanner" Style="{StaticResource ChoicePillRadioButton}" Content="顶端横幅" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="DisplayModeFullScreenRadioButton" GroupName="DisplayMode" Tag="FullScreen" Style="{StaticResource ChoicePillRadioButton}" Content="全屏覆盖" Checked="BannerSettingsControlChanged" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="14" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="文字与时长" />

                                    <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="滚动速度" />
                                    <Slider x:Name="BannerSpeedSlider" Minimum="80" Maximum="320" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="BannerSettingsControlChanged" />
                                    <TextBlock x:Name="BannerSpeedValueTextBlock" Margin="0,4,0,0" Foreground="#64748B" Text="160 px/s" />

                                    <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="字体大小" />
                                    <Slider x:Name="BannerFontSizeSlider" Minimum="18" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="BannerSettingsControlChanged" />
                                    <TextBlock x:Name="BannerFontSizeValueTextBlock" Margin="0,4,0,0" Foreground="#64748B" Text="24 px" />

                                    <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="默认停留时长" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton x:Name="Duration10RadioButton" GroupName="BannerDuration" Tag="10" Style="{StaticResource ChoicePillRadioButton}" Content="10 秒" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="Duration30RadioButton" GroupName="BannerDuration" Tag="30" Style="{StaticResource ChoicePillRadioButton}" Content="30 秒" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="Duration60RadioButton" GroupName="BannerDuration" Tag="60" Style="{StaticResource ChoicePillRadioButton}" Content="60 秒" Checked="BannerSettingsControlChanged" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="14" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="通知颜色" />

                                    <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="普通通知颜色" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton x:Name="NormalSteelBlueRadioButton" GroupName="NormalColor" Tag="SteelBlue" Style="{StaticResource ChoicePillRadioButton}" Content="蓝色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="NormalSeaGreenRadioButton" GroupName="NormalColor" Tag="SeaGreen" Style="{StaticResource ChoicePillRadioButton}" Content="绿色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="NormalMediumPurpleRadioButton" GroupName="NormalColor" Tag="MediumPurple" Style="{StaticResource ChoicePillRadioButton}" Content="紫色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="NormalSlateGrayRadioButton" GroupName="NormalColor" Tag="SlateGray" Style="{StaticResource ChoicePillRadioButton}" Content="深灰" Checked="BannerSettingsControlChanged" />
                                    </WrapPanel>

                                    <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="重要通知颜色" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton x:Name="ImportantOrangeRadioButton" GroupName="ImportantColor" Tag="Orange" Style="{StaticResource ChoicePillRadioButton}" Content="橙色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="ImportantGoldRadioButton" GroupName="ImportantColor" Tag="Gold" Style="{StaticResource ChoicePillRadioButton}" Content="金色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="ImportantCoralRadioButton" GroupName="ImportantColor" Tag="Coral" Style="{StaticResource ChoicePillRadioButton}" Content="珊瑚色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="ImportantTomatoRadioButton" GroupName="ImportantColor" Tag="Tomato" Style="{StaticResource ChoicePillRadioButton}" Content="番茄红" Checked="BannerSettingsControlChanged" />
                                    </WrapPanel>

                                    <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="紧急通知颜色" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton x:Name="UrgentRedRadioButton" GroupName="UrgentColor" Tag="Red" Style="{StaticResource ChoicePillRadioButton}" Content="红色" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="UrgentDarkRedRadioButton" GroupName="UrgentColor" Tag="DarkRed" Style="{StaticResource ChoicePillRadioButton}" Content="深红" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="UrgentOrangeRedRadioButton" GroupName="UrgentColor" Tag="OrangeRed" Style="{StaticResource ChoicePillRadioButton}" Content="橙红" Checked="BannerSettingsControlChanged" />
                                        <RadioButton x:Name="UrgentCrimsonRadioButton" GroupName="UrgentColor" Tag="Crimson" Style="{StaticResource ChoicePillRadioButton}" Content="绯红" Checked="BannerSettingsControlChanged" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Button Margin="0,16,0,0" Padding="12,8" Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155" Content="恢复默认设置" Click="BannerResetToDefaultClicked" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
