<Window x:Class="SchoolNotify.WindowsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="School Notify Client"
        Height="520"
        Width="860"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20" Background="#0F172A" CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="White" Text="校园通知屏客户端" />
                <TextBlock x:Name="StatusSummaryTextBlock" Margin="0,8,0,0" Foreground="#CBD5E1" Text="正在初始化客户端..." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="设备信息" />
                    <TextBlock x:Name="DeviceNameTextBlock" Margin="0,12,0,0" Text="设备名称：-" />
                    <TextBlock x:Name="DeviceIdTextBlock" Margin="0,8,0,0" Text="设备 ID：-" />
                    <TextBlock x:Name="ConnectionStatusTextBlock" Margin="0,8,0,0" Text="连接状态：未连接" />
                    <TextBlock x:Name="LastHeartbeatTextBlock" Margin="0,8,0,0" Text="最后心跳：-" />
                    <TextBlock x:Name="ReconnectStatusTextBlock" Margin="0,8,0,0" Text="重连状态：未启动" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="绑定信息" />
                    <TextBlock x:Name="BindingCodeTextBlock" Margin="0,12,0,0" Text="绑定码：-" />
                    <TextBlock x:Name="BindingPayloadTextBlock" Margin="0,8,0,0" Foreground="#475569" Text="扫码内容：-" TextWrapping="Wrap" />
                    <Border Width="180" Height="180" Margin="0,16,0,0" Background="#E2E8F0" CornerRadius="12">
                        <Image x:Name="QrImage" Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="后续开发入口" />
                    <TextBlock Margin="0,12,0,0" Text="1. 设备注册与令牌管理" />
                    <TextBlock Margin="0,6,0,0" Text="2. WebSocket 在线与心跳" />
                    <TextBlock Margin="0,6,0,0" Text="3. 顶部滚动横幅与短卡片提醒" />
                    <TextBlock Margin="0,6,0,0" Text="4. 系统托盘、开机自启与 TTS" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="横幅设置" />
                    <TextBlock Margin="0,12,0,0" Text="滚动速度" />
                    <Slider x:Name="BannerSpeedSlider" Minimum="80" Maximum="320" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="BannerSettingsControlChanged" />
                    <TextBlock x:Name="BannerSpeedValueTextBlock" Margin="0,4,0,0" Foreground="#475569" Text="160 px/s" />

                    <TextBlock Margin="0,12,0,0" Text="字体大小" />
                    <Slider x:Name="BannerFontSizeSlider" Minimum="18" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="BannerSettingsControlChanged" />
                    <TextBlock x:Name="BannerFontSizeValueTextBlock" Margin="0,4,0,0" Foreground="#475569" Text="24 px" />

                    <TextBlock Margin="0,12,0,0" Text="普通通知颜色" />
                    <ComboBox x:Name="BannerNormalColorComboBox" SelectionChanged="BannerSettingsControlChanged">
                        <ComboBoxItem Content="蓝色" Tag="SteelBlue" />
                        <ComboBoxItem Content="绿色" Tag="SeaGreen" />
                        <ComboBoxItem Content="紫色" Tag="MediumPurple" />
                        <ComboBoxItem Content="深灰" Tag="SlateGray" />
                    </ComboBox>

                    <TextBlock Margin="0,12,0,0" Text="重要通知颜色" />
                    <ComboBox x:Name="BannerImportantColorComboBox" SelectionChanged="BannerSettingsControlChanged">
                        <ComboBoxItem Content="橙色" Tag="Orange" />
                        <ComboBoxItem Content="金色" Tag="Gold" />
                        <ComboBoxItem Content="珊瑚色" Tag="Coral" />
                        <ComboBoxItem Content="番茄红" Tag="Tomato" />
                    </ComboBox>

                    <TextBlock Margin="0,12,0,0" Text="紧急通知颜色" />
                    <ComboBox x:Name="BannerUrgentColorComboBox" SelectionChanged="BannerSettingsControlChanged">
                        <ComboBoxItem Content="红色" Tag="Red" />
                        <ComboBoxItem Content="深红" Tag="DarkRed" />
                        <ComboBoxItem Content="橙红" Tag="OrangeRed" />
                        <ComboBoxItem Content="绯红" Tag="Crimson" />
                    </ComboBox>

                    <TextBlock Margin="0,12,0,0" Text="停留时长" />
                    <ComboBox x:Name="BannerDurationComboBox" SelectionChanged="BannerSettingsControlChanged">
                        <ComboBoxItem Content="10 秒" Tag="10" />
                        <ComboBoxItem Content="30 秒" Tag="30" />
                        <ComboBoxItem Content="60 秒" Tag="60" />
                    </ComboBox>

                    <Button Margin="0,16,0,0" Padding="8,6" Content="恢复默认" Click="BannerResetToDefaultClicked" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
