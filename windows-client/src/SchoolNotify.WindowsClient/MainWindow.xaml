<Window x:Class="SchoolNotify.WindowsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="思故桌面小喇叭"
        Height="720"
        Width="1040"
        MinHeight="640"
        MinWidth="920"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#FFF7ED">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF7ED" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFBF5" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#2F241D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7C6B5F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEDD5" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="LineBrush" Color="#F1DCC9" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#D8B79A" BlurRadius="22" ShadowDepth="6" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="#5F4B3F" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoicePillRadioButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#FFFBF5" />
            <Setter Property="BorderBrush" Value="#E8CBB3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#F97316" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#F97316" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#14B8A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="28" Background="#FFF1E4" CornerRadius="26" BorderBrush="#F5CBA7" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#D8A06F" BlurRadius="28" ShadowDepth="8" Opacity="0.20" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="66" Height="66" CornerRadius="20" Background="White" BorderBrush="#F5CBA7" BorderThickness="1" VerticalAlignment="Center">
                        <Image Width="52"
                               Height="52"
                               Source="pack://application:,,,/Assets/brand-speaker.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="30" FontWeight="Bold" Foreground="#2F241D" Text="思故桌面小喇叭" />
                        <TextBlock x:Name="StatusSummaryTextBlock"
                                   Margin="0,8,0,0"
                                   Foreground="#7C6B5F"
                                   Text="正在初始化客户端..."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            MinWidth="132"
                            Padding="18,11"
                            VerticalAlignment="Center"
                            Background="#F97316"
                            BorderBrush="#FB923C"
                            Foreground="White"
                            Content="⚙ 通知设置"
                            Click="SettingsButtonClicked" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="设备运行状态" />
                        <TextBlock x:Name="DeviceNameTextBlock" Style="{StaticResource InfoText}" Text="设备名称：-" />
                        <TextBlock x:Name="DeviceIdTextBlock" Style="{StaticResource InfoText}" Text="设备 ID：-" />
                        <TextBlock x:Name="ClientVersionTextBlock" Style="{StaticResource InfoText}" Text="客户端版本：-" />
                        <TextBlock x:Name="ConnectionStatusTextBlock" Style="{StaticResource InfoText}" Foreground="#475569" Text="连接状态：未连接" />
                        <TextBlock x:Name="LastHeartbeatTextBlock" Style="{StaticResource InfoText}" Text="最后心跳：-" />
                        <TextBlock x:Name="ReconnectStatusTextBlock" Style="{StaticResource InfoText}" Text="实时连接：未启动" />
                        <Border Margin="0,14,0,0" Padding="12" Background="#FFF7ED" CornerRadius="14" BorderBrush="#FED7AA" BorderThickness="1">
                            <TextBlock x:Name="UpdateStatusTextBlock" Foreground="#C2410C" Text="更新状态：等待检查" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="小程序绑定" />
                            <TextBlock x:Name="BindingCodeTextBlock" Margin="0,12,0,0" FontSize="38" FontWeight="Bold" Foreground="#EA580C" Text="绑定码：-" />
                            <TextBlock x:Name="BindingCodeCountdownTextBlock" Margin="0,8,0,0" Foreground="#64748B" Text="二维码有效期：-" />
                            <Button Margin="0,14,0,0" Background="#FFEDD5" BorderBrush="#FDBA74" Foreground="#9A3412" Content="刷新二维码" Click="RefreshBindingCodeButtonClicked" />
                            <TextBlock x:Name="BindingPayloadTextBlock" Visibility="Collapsed" Margin="0,8,0,0" Foreground="#475569" Text="扫码内容：-" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="2" Width="190" Height="190" Margin="0,20,0,0" Background="#FFFBF5" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Margin="12" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="使用提示" />
                        <Border Margin="0,14,0,0" Padding="14" Background="#FFFBF5" CornerRadius="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource InfoText}" Margin="0" Text="1. 在线状态使用中文和颜色标识" />
                                <TextBlock Style="{StaticResource InfoText}" Text="2. 绑定码和二维码用于小程序绑定" />
                                <TextBlock Style="{StaticResource InfoText}" Text="3. 通知显示方式可在右侧设置" />
                                <TextBlock Style="{StaticResource InfoText}" Text="4. 时间按北京时间显示" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsPanel" Grid.Column="2" Padding="0" Background="White" CornerRadius="24" BorderBrush="#FED7AA" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#D8B79A" BlurRadius="22" ShadowDepth="6" Opacity="0.16" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Padding="20" Background="#FFF1E4" CornerRadius="24,24,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="21" FontWeight="Bold" Foreground="#9A3412" Text="通知显示设置" />
                                    <TextBlock Margin="0,6,0,0" Foreground="#7C2D12" Text="控制开机自启、通知位置、颜色与停留时间。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="18">
                                <Border Padding="15" Background="#F8FAFC" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#2F241D" Text="基础设置" />
                                        <CheckBox x:Name="AutoStartCheckBox" Margin="0,12,0,0" Content="开机自动启动（推荐开启）" IsChecked="True" Checked="ClientSettingsControlChanged" Unchecked="ClientSettingsControlChanged" />

                                        <TextBlock Margin="0,14,0,0" Foreground="#334155" FontWeight="SemiBold" Text="通知显示方式" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <RadioButton x:Name="DisplayModeTopBannerRadioButton" GroupName="DisplayMode" Tag="TopBanner" Style="{StaticResource ChoicePillRadioButton}" Content="顶端横幅" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="DisplayModeFullScreenRadioButton" GroupName="DisplayMode" Tag="FullScreen" Style="{StaticResource ChoicePillRadioButton}" Content="全屏覆盖" Checked="BannerSettingsControlChanged" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Padding="15" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#2F241D" Text="文字与时长" />

                                        <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="滚动速度" />
                                        <Slider x:Name="BannerSpeedSlider" Minimum="80" Maximum="320" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="BannerSettingsControlChanged" />
                                        <TextBlock x:Name="BannerSpeedValueTextBlock" Margin="0,4,0,0" Foreground="#64748B" Text="160 px/s" />

                                        <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="字体大小" />
                                        <Slider x:Name="BannerFontSizeSlider" Minimum="18" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="BannerSettingsControlChanged" />
                                        <TextBlock x:Name="BannerFontSizeValueTextBlock" Margin="0,4,0,0" Foreground="#64748B" Text="24 px" />

                                        <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="默认停留时长" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <RadioButton x:Name="Duration10RadioButton" GroupName="BannerDuration" Tag="10" Style="{StaticResource ChoicePillRadioButton}" Content="10 秒" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="Duration30RadioButton" GroupName="BannerDuration" Tag="30" Style="{StaticResource ChoicePillRadioButton}" Content="30 秒" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="Duration60RadioButton" GroupName="BannerDuration" Tag="60" Style="{StaticResource ChoicePillRadioButton}" Content="60 秒" Checked="BannerSettingsControlChanged" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Padding="15" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#2F241D" Text="通知颜色" />

                                        <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="普通通知颜色" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <RadioButton x:Name="NormalSteelBlueRadioButton" GroupName="NormalColor" Tag="SteelBlue" Style="{StaticResource ChoicePillRadioButton}" Content="蓝色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="NormalSeaGreenRadioButton" GroupName="NormalColor" Tag="SeaGreen" Style="{StaticResource ChoicePillRadioButton}" Content="绿色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="NormalMediumPurpleRadioButton" GroupName="NormalColor" Tag="MediumPurple" Style="{StaticResource ChoicePillRadioButton}" Content="紫色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="NormalSlateGrayRadioButton" GroupName="NormalColor" Tag="SlateGray" Style="{StaticResource ChoicePillRadioButton}" Content="深灰" Checked="BannerSettingsControlChanged" />
                                        </WrapPanel>

                                        <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="重要通知颜色" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <RadioButton x:Name="ImportantOrangeRadioButton" GroupName="ImportantColor" Tag="Orange" Style="{StaticResource ChoicePillRadioButton}" Content="橙色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="ImportantGoldRadioButton" GroupName="ImportantColor" Tag="Gold" Style="{StaticResource ChoicePillRadioButton}" Content="金色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="ImportantCoralRadioButton" GroupName="ImportantColor" Tag="Coral" Style="{StaticResource ChoicePillRadioButton}" Content="珊瑚色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="ImportantTomatoRadioButton" GroupName="ImportantColor" Tag="Tomato" Style="{StaticResource ChoicePillRadioButton}" Content="番茄红" Checked="BannerSettingsControlChanged" />
                                        </WrapPanel>

                                        <TextBlock Margin="0,12,0,0" Foreground="#334155" Text="紧急通知颜色" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <RadioButton x:Name="UrgentRedRadioButton" GroupName="UrgentColor" Tag="Red" Style="{StaticResource ChoicePillRadioButton}" Content="红色" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="UrgentDarkRedRadioButton" GroupName="UrgentColor" Tag="DarkRed" Style="{StaticResource ChoicePillRadioButton}" Content="深红" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="UrgentOrangeRedRadioButton" GroupName="UrgentColor" Tag="OrangeRed" Style="{StaticResource ChoicePillRadioButton}" Content="橙红" Checked="BannerSettingsControlChanged" />
                                            <RadioButton x:Name="UrgentCrimsonRadioButton" GroupName="UrgentColor" Tag="Crimson" Style="{StaticResource ChoicePillRadioButton}" Content="绯红" Checked="BannerSettingsControlChanged" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,16,0,0" Padding="12,8" Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155" Content="恢复默认设置" Click="BannerResetToDefaultClicked" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
