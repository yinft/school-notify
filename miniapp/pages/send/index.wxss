.send-quick-actions {
  margin-bottom: 20rpx;
}

.send-hero-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.28;
}

.send-action-strip {
  padding: 14rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #eef6ff 0%, #f8fbff 100%);
  border: 1rpx solid #dceaff;
}

.send-empty-actions {
  justify-content: center;
}

.device-list {
  overflow: hidden;
}

.device-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf4ff;
}

.device-option:last-child {
  border-bottom: none;
}

.device-option:active {
  background: rgba(47, 128, 255, 0.06);
}

.device-toggle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c8d6e5;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.device-toggle-on {
  background: #2f80ff;
  border-color: #2f80ff;
}

.device-toggle-on .device-toggle-check {
  opacity: 1;
}

.device-toggle-check {
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg) translateY(-2rpx);
  opacity: 0;
  transition: opacity 0.15s ease;
}

.device-option-body {
  flex: 1;
}

.device-option:nth-child(odd) {
  background: linear-gradient(90deg, rgba(47, 128, 255, 0.04) 0%, rgba(47, 128, 255, 0) 100%);
}

.device-option-name {
  font-weight: 700;
  font-size: 29rpx;
  color: #16324f;
}

.device-option-meta {
  margin-top: 8rpx;
  color: #6f88a4;
  font-size: 24rpx;
}
