.device-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.device-option:last-child {
  border-bottom: none;
}

.device-option-body {
  flex: 1;
}

.device-option-name {
  font-weight: 600;
  font-size: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  padding: 22rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
}

.form-textarea {
  min-height: 200rpx;
}

.form-picker {
  padding: 22rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  border: 2rpx solid #e2e8f0;
  font-size: 28rpx;
  color: #0f172a;
}

.submit-btn {
  background: #0f172a;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin-top: 36rpx;
}

.submit-btn-disabled {
  opacity: 0.5;
}
