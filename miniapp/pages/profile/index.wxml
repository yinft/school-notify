<view class="page">
  <view class="profile-header">
    <view class="avatar">👤</view>
    <view class="user-info">
      <view class="user-name">校园通知屏用户</view>
      <view class="user-id muted">ID：{{userId}}</view>
    </view>
  </view>

  <view style="height: 24rpx;"></view>

  <view class="card">
    <view class="menu-item" bindtap="goToBind">
      <view class="menu-icon">🔗</view>
      <view class="menu-text">绑定新设备</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goToRecords">
      <view class="menu-icon">📋</view>
      <view class="menu-text">发送记录</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view style="height: 24rpx;"></view>

  <view class="card">
    <view class="menu-item">
      <view class="menu-icon">📞</view>
      <view class="menu-text">版本信息</view>
      <view class="muted">0.1.0</view>
    </view>
  </view>
</view>
