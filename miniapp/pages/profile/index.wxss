.profile-page-body {
  overflow-y: auto;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 14rpx;
  justify-content: flex-start;
  width: 100%;
}

.profile-avatar-wrap {
  width: 108rpx !important;
  height: 108rpx !important;
  min-width: 108rpx;
  min-height: 108rpx;
  max-width: 108rpx;
  max-height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: visible;
  padding: 6rpx !important;
  margin: 0 !important;
  border: none;
  background: transparent;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: left;
  box-sizing: border-box;
}

.profile-avatar-wrap::after {
  border: none;
}

.profile-avatar-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.profile-avatar-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.14);
}

.profile-avatar-default {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-nick-field {
  width: 100%;
}

.profile-nick-display {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.4;
}

.profile-nick-input {
  width: 100%;
  min-height: 52rpx;
  padding: 0;
  margin-top: 8rpx;
  border: none;
  background: transparent;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.profile-nick-placeholder {
  color: #ffffff;
}

.profile-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  filter: blur(6rpx);
}

.profile-glow-a {
  width: 160rpx;
  height: 160rpx;
  right: -30rpx;
  top: -20rpx;
}

.profile-glow-b {
  width: 110rpx;
  height: 110rpx;
  right: 110rpx;
  bottom: -28rpx;
}

.profile-sync-notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  position: relative;
  z-index: 2;
}

.profile-sync-copy {
  min-width: 0;
}

.profile-sync-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-sync-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}

.profile-sync-action {
  margin-top: 18rpx;
  flex-shrink: 0;
  min-width: 176rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f80ff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf4ff;
}

.menu-item:first-child {
  padding-top: 10rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2f80ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.menu-text-group {
  flex: 1;
}

.menu-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #16324f;
}

.menu-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6f88a4;
}

.menu-arrow {
  color: #b7cce8;
  font-size: 36rpx;
  font-weight: 300;
}

.version-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-row {
  padding: 20rpx 0;
}

.contact-row + .contact-row {
  border-top: 1rpx solid #edf4ff;
}

.version-label {
  font-size: 28rpx;
  color: #5d7894;
}

.version-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #16324f;
}

.profile-logout-button {
  color: #d64545;
  background: #fff4f4;
  border-color: #ffd5d5;
}
