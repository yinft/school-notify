.profile-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
}

.profile-avatar-wrap::after {
  border: none;
}

.profile-avatar-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.14);
}

.profile-avatar-default {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-nick {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.profile-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  filter: blur(6rpx);
}

.profile-glow-a {
  width: 160rpx;
  height: 160rpx;
  right: -30rpx;
  top: -20rpx;
}

.profile-glow-b {
  width: 110rpx;
  height: 110rpx;
  right: 110rpx;
  bottom: -28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf4ff;
}

.menu-item:first-child {
  padding-top: 10rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2f80ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.menu-text-group {
  flex: 1;
}

.menu-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #16324f;
}

.menu-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6f88a4;
}

.menu-arrow {
  color: #b7cce8;
  font-size: 36rpx;
  font-weight: 300;
}

.version-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.version-label {
  font-size: 28rpx;
  color: #5d7894;
}

.version-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #16324f;
}

.profile-nick-input {
  display: block;
  min-height: 56rpx;
  padding: 0;
}

.profile-nick-input::placeholder {
  color: rgba(255, 255, 255, 0.72);
}

.profile-save-button {
  margin: 28rpx 0 0;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.profile-save-button::after {
  border: none;
}

.profile-logout-button {
  color: #d64545;
  background: #fff4f4;
  border-color: #ffd5d5;
}
