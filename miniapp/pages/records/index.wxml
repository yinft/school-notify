<view class="page">
  <view class="card">
    <view class="section-title">通知发送记录</view>

    <view wx:if="{{isLoading}}" class="empty-state">
      <view class="muted">正在加载记录...</view>
    </view>
    <view wx:elif="{{errorText}}" class="empty-state">
      <view class="status-offline">{{errorText}}</view>
    </view>
    <view wx:elif="{{!records.length}}" class="empty-state">
      <view class="empty-icon">📭</view>
      <view class="empty-text">当前还没有发送记录</view>
    </view>

    <block wx:else>
      <view wx:for="{{records}}" wx:key="id" class="record-card">
        <view class="record-header">
          <view class="record-title">{{item.title}}</view>
          <view class="badge badge-{{item.level}}">{{item.level}}</view>
        </view>
        <view class="record-content">{{item.content}}</view>
        <view class="record-summary">{{item.deliverySummary}}</view>

        <block wx:for="{{item.deliveries}}" wx:key="deviceId">
          <view class="delivery-row">
            <view class="delivery-device">{{item.deviceId}}</view>
            <view class="delivery-status">{{item.statusText}}</view>
          </view>
        </block>
      </view>
    </block>
  </view>
</view>
