.auth-page {
  display: flex;
  align-items: center;
}

.auth-card {
  width: 100%;
  padding: 48rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f9ff 100%);
  border: 1rpx solid #dce8ff;
  box-shadow: 0 20rpx 40rpx rgba(39, 97, 170, 0.12);
  text-align: center;
}

.auth-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.auth-logo-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2f80ff 0%, #5ba8ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.auth-icon-head {
  position: absolute;
  top: 18rpx;
  left: 26rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.auth-icon-body {
  position: absolute;
  bottom: 14rpx;
  left: 18rpx;
  width: 44rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  border-bottom: none;
  box-sizing: border-box;
}

.auth-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #16324f;
  line-height: 1.3;
}

.auth-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f7996;
}
