.device-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-row:last-child {
  border-bottom: none;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #1e293b;
}

.device-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.device-meta-item {
  font-size: 24rpx;
  color: #94a3b8;
}

.status-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: middle;
}

.status-dot-online {
  background: #22c55e;
}

.status-dot-offline {
  background: #ef4444;
}

.device-status {
  font-size: 24rpx;
  font-weight: 600;
}

.bind-btn {
  background: #0f172a;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  font-weight: 600;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 48rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  color: #94a3b8;
  font-size: 28rpx;
}
