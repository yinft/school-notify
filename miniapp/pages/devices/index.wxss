.device-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf4ff;
  border-left: 6rpx solid transparent;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.device-row:last-child {
  border-bottom: none;
}

.device-row:nth-child(odd) {
  border-left-color: #d7e8ff;
  padding-left: 16rpx;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #16324f;
}

.device-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.device-meta-item {
  font-size: 24rpx;
  color: #7189a4;
}
