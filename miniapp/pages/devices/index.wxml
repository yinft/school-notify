<import src="../../templates/login-gate.wxml" />

<view class="page-shell">
  <native-title-bar title="设备" />
  <view class="page {{isLoginRequired ? 'page-login' : ''}}">
    <block wx:if="{{isLoginRequired}}">
      <template is="login-gate" data="{{ loginGate: loginGate, isAuthorizingLogin: isAuthorizingLogin }}" />
    </block>

    <block wx:else>
      <view class="page-body">
        <view class="hero-card hero-card-devices hero-card-compact">
          <view class="hero-overline">设备总览</view>
          <view class="hero-simple-row">
            <view class="hero-simple-main">
              <view class="hero-title">设备状态一目了然</view>
              <view class="hero-subtitle">优先查看在线设备，快速确认桌面提醒设备当前是否可用。</view>
            </view>
            <view class="hero-simple-highlight">
              <view class="hero-simple-highlight-value">{{onlineCount}}</view>
              <view class="hero-simple-highlight-label">在线设备</view>
            </view>
          </view>
          <view class="hero-simple-meta">
            <view class="hero-simple-chip">共 {{devices.length}} 台设备</view>
            <view class="hero-simple-chip">状态概览</view>
          </view>
        </view>

        <view class="card stack-lg">
          <view class="section-header">
            <view class="section-title">设备列表</view>
            <view class="section-meta">共 {{devices.length}} 台</view>
          </view>

          <view wx:if="{{isLoading}}" class="state-panel">
            <view class="state-loading" aria-label="加载中">
              <view class="state-loading-dot state-loading-dot-1"></view>
              <view class="state-loading-dot state-loading-dot-2"></view>
              <view class="state-loading-dot state-loading-dot-3"></view>
            </view>
            <view class="state-title">正在同步设备</view>
            <view class="state-text">请稍候，系统正在更新你的设备状态。</view>
          </view>
          <view wx:elif="{{errorText}}" class="state-panel state-panel-error">
            <view class="state-icon">!</view>
            <view class="state-title">设备加载失败</view>
            <view class="state-text">{{errorText}}</view>
            <view class="state-action">
              <view class="button-inline" bindtap="loadDevices">重新加载</view>
            </view>
          </view>
          <view wx:elif="{{!devices.length}}" class="state-panel">
            <view class="state-icon">+</view>
            <view class="state-title">还没有绑定设备</view>
            <view class="state-text">先绑定一台 Windows 客户端设备，才能开始接收和管理通知。</view>
            <view class="state-action">
              <view class="button-inline" bindtap="goToBind">去绑定设备</view>
            </view>
          </view>
          <block wx:else>
            <view wx:for="{{devices}}" wx:key="id" class="device-row">
              <view class="device-info">
                <view class="device-name">{{item.name}}</view>
                <view wx:if="{{item.locationLabel}}" class="device-location">{{item.locationLabel}}</view>
                <view class="device-meta">
                  <view class="device-meta-item">{{item.lastSeenText}}</view>
                  <view class="device-meta-item">客户端 {{item.clientVersion}}</view>
                </view>
                <view class="device-actions">
                  <view class="device-action-link device-action-link-edit" data-device-id="{{item.id}}" data-device-name="{{item.name}}" data-location-label="{{item.locationLabel}}" bindtap="startEditDevice">编辑信息</view>
                  <view class="device-action-link" data-device-id="{{item.id}}" data-device-name="{{item.name}}" bindtap="unbindDevice">解绑设备</view>
                </view>
                <view wx:if="{{editingDeviceId === item.id}}" class="device-edit-panel">
                  <view class="field-label">设备名称</view>
                  <input class="field-input field-input-single" placeholder-class="field-input-placeholder" placeholder="例如：办公室提醒屏" value="{{editDeviceName}}" bindinput="onEditDeviceNameInput" />
                  <view class="field-label">设备位置</view>
                  <input class="field-input field-input-single" placeholder-class="field-input-placeholder" placeholder="例如：办公室" value="{{editLocationLabel}}" bindinput="onEditLocationInput" />
                  <view class="device-edit-actions">
                    <view class="button-inline" bindtap="saveDeviceEdit">{{isSavingDevice ? '保存中' : '保存'}}</view>
                    <view class="button-inline button-inline-muted" bindtap="cancelEditDevice">取消</view>
                  </view>
                </view>
              </view>
              <view class="status-chip {{item.status === 'online' ? 'status-chip-online' : 'status-chip-offline'}}">
                <view class="status-dot"></view>
                <view>{{item.statusText}}</view>
              </view>
            </view>
          </block>
        </view>

        <view class="card">
          <view class="section-header">
            <view class="section-title">快捷操作</view>
            <view class="section-meta">管理更轻松</view>
          </view>

          <view class="button-primary" bindtap="goToBind">+ 绑定新设备</view>
        </view>
      </view>
    </block>
  </view>
</view>
