<view class="page">
  <view class="card">
    <view class="section-title">已绑定设备</view>

    <view wx:if="{{isLoading}}" class="empty-state">
      <view class="muted">正在加载设备...</view>
    </view>
    <view wx:elif="{{errorText}}" class="empty-state">
      <view class="status-offline">{{errorText}}</view>
    </view>
    <view wx:elif="{{!devices.length}}" class="empty-state">
      <view class="empty-icon">📱</view>
      <view class="empty-text">当前还没有绑定设备</view>
    </view>
    <block wx:else>
      <view wx:for="{{devices}}" wx:key="id" class="device-row">
        <view class="device-info">
          <view class="device-name">{{item.name}}</view>
          <view class="device-meta">
            <view class="device-meta-item">{{item.lastSeenText}}</view>
            <view class="device-meta-item">v{{item.clientVersion}}</view>
          </view>
        </view>
        <view class="device-status {{item.status === 'online' ? 'status-online' : 'status-offline'}}">
          <view class="status-dot {{item.status === 'online' ? 'status-dot-online' : 'status-dot-offline'}}"></view>
          {{item.statusText}}
        </view>
      </view>
    </block>
  </view>

  <view class="bind-btn" bindtap="goToBind">＋ 绑定新设备</view>
</view>
