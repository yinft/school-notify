<import src="../../templates/login-gate.wxml" />

<view class="page-shell">
  <native-title-bar title="绑定设备" show-back="{{true}}" />
  <view class="page {{isLoginRequired ? 'page-login' : ''}}">
    <block wx:if="{{isLoginRequired}}">
      <template is="login-gate" data="{{ loginGate: loginGate, isAuthorizingLogin: isAuthorizingLogin }}" />
    </block>

    <block wx:else>
      <view class="page-body">
        <view class="hero-card hero-card-bind hero-card-compact">
          <view class="hero-overline">接入引导</view>
          <view class="hero-title">把新设备接入当前账号</view>
          <view class="hero-subtitle">输入客户端上的绑定码，或直接扫码识别，几步完成设备接入。</view>
          <view class="hero-simple-meta hero-simple-meta-single">
            <view class="hero-simple-chip">1 获取绑定码</view>
            <view class="hero-simple-chip">2 输入或扫码</view>
            <view class="hero-simple-chip">3 完成绑定</view>
          </view>
        </view>

        <view class="card stack-lg">
          <view class="section-header">
            <view class="section-title">绑定新设备</view>
            <view class="section-meta">操作简单快捷</view>
          </view>
          <view class="muted">{{helperText}}</view>

          <view class="field-label">绑定码</view>
          <input
            class="field-input field-input-single"
            placeholder-class="field-input-placeholder"
            placeholder="请输入绑定码"
            maxlength="12"
            bindinput="onCodeInput"
            value="{{code}}"
          />
          <view class="field-helper">支持手动输入或扫码识别，输入时会自动规范化为大写格式。</view>

          <view class="bind-actions stack-lg">
            <view class="button-secondary" bindtap="scanCode">扫码识别绑定码</view>
            <view class="button-secondary {{isLoadingPreview ? 'button-disabled' : ''}}" bindtap="previewDevice">
              {{isLoadingPreview ? '识别中...' : '识别设备'}}
            </view>
          </view>

          <view wx:if="{{previewDeviceId}}" class="bind-preview-card">
            <view class="bind-preview-eyebrow">待绑定设备</view>
            <view class="bind-preview-id">{{previewDeviceId}}</view>
          </view>

          <view class="field-label">设备名称</view>
          <input
            class="field-input field-input-single"
            placeholder-class="field-input-placeholder"
            placeholder="默认使用客户端注册名称，可自行修改"
            maxlength="64"
            bindinput="onDeviceNameInput"
            value="{{deviceName}}"
          />

          <view class="field-label">位置备注</view>
          <input
            class="field-input field-input-single"
            placeholder-class="field-input-placeholder"
            placeholder="例如：办公室"
            maxlength="64"
            bindinput="onLocationLabelInput"
            value="{{locationLabel}}"
          />

          <view class="button-primary {{isSubmitting ? 'button-disabled' : ''}} stack-lg" bindtap="submit">
            {{isSubmitting ? '绑定中...' : '立即绑定'}}
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
