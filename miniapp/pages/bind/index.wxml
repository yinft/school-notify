<view class="page">
  <view class="card">
    <view class="section-title">绑定新设备</view>
    <view class="muted">{{helperText}}</view>

    <view class="form-label">绑定码</view>
    <input
      class="form-input"
      placeholder="请输入 6 位绑定码"
      maxlength="12"
      bindinput="onCodeInput"
      value="{{code}}"
    />

    <view class="scan-btn" bindtap="scanCode">
      📷 扫码识别绑定码
    </view>

    <view class="submit-btn {{isSubmitting ? 'submit-btn-disabled' : ''}}" bindtap="submit">
      {{isSubmitting ? '绑定中...' : '立即绑定'}}
    </view>
  </view>
</view>
