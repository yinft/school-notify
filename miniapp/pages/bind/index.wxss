.form-label {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  padding: 22rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
}

.scan-btn {
  margin-top: 20rpx;
  padding: 20rpx;
  text-align: center;
  background: #f8fafc;
  border-radius: 14rpx;
  color: #475569;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
}

.submit-btn {
  background: #0f172a;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin-top: 28rpx;
}

.submit-btn-disabled {
  opacity: 0.5;
}
