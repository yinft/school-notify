.tab-bar {
  display: flex;
  position: fixed;
  bottom: 18rpx;
  left: 20rpx;
  right: 20rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #dce9ff;
  border-radius: 999rpx;
  padding: 10rpx;
  box-shadow: 0 12rpx 28rpx rgba(41, 97, 173, 0.14);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 116rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.tab-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #edf5ff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-icon::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(94, 122, 151, 0.12);
}

.tab-text {
  font-size: 22rpx;
  color: #6c87a3;
  font-weight: 600;
}

.tab-item.active .tab-pill {
  background: linear-gradient(135deg, #e8f2ff 0%, #f3f8ff 100%);
}

.tab-item.active .tab-icon {
  background: linear-gradient(135deg, #2f80ff 0%, #64b2ff 100%);
}

.tab-item.active .tab-icon::after {
  border-color: rgba(255, 255, 255, 0.18);
}

.tab-item.active .tab-text {
  color: #1f4f87;
}

.icon-monitor,
.icon-plane,
.icon-list,
.icon-user {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}

.icon-monitor-screen {
  position: absolute;
  left: 1rpx;
  top: 2rpx;
  width: 20rpx;
  height: 13rpx;
  border: 2rpx solid #5e7a97;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.icon-monitor-stand {
  position: absolute;
  left: 8rpx;
  bottom: 1rpx;
  width: 6rpx;
  height: 6rpx;
  border-left: 2rpx solid #5e7a97;
  border-bottom: 2rpx solid #5e7a97;
  transform: skew(-15deg);
  box-sizing: border-box;
}

.icon-plane-body {
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #5e7a97;
  border-right: 2rpx solid #5e7a97;
  transform: rotate(18deg) skew(-8deg);
  box-sizing: border-box;
}

.icon-plane-tail {
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 8rpx;
  height: 2rpx;
  background: #5e7a97;
  transform: rotate(-20deg);
  border-radius: 999rpx;
}

.icon-list {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.icon-list-line {
  width: 18rpx;
  height: 2rpx;
  background: #5e7a97;
  border-radius: 999rpx;
}

.icon-list-line-short {
  width: 12rpx;
}

.icon-user-head {
  position: absolute;
  left: 6rpx;
  top: 1rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #5e7a97;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-user-body {
  position: absolute;
  left: 4rpx;
  bottom: 1rpx;
  width: 14rpx;
  height: 8rpx;
  border: 2rpx solid #5e7a97;
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
  border-bottom: none;
  box-sizing: border-box;
}

.tab-item.active .icon-monitor-screen,
.tab-item.active .icon-monitor-stand,
.tab-item.active .icon-plane-body,
.tab-item.active .icon-plane-tail,
.tab-item.active .icon-list-line,
.tab-item.active .icon-user-head,
.tab-item.active .icon-user-body {
  border-color: #ffffff;
  background: #ffffff;
}
