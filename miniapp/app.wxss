page {
  background: #f1f5f9;
  color: #0f172a;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #0f172a;
}

.muted {
  color: #94a3b8;
  font-size: 26rpx;
}

.status-online {
  color: #22c55e;
  font-weight: 600;
}

.status-offline {
  color: #ef4444;
}

.btn-primary {
  background: #0f172a;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin-top: 24rpx;
}

.btn-primary-disabled {
  opacity: 0.5;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.badge-normal {
  background: #3b82f6;
}

.badge-important {
  background: #f97316;
}

.badge-urgent {
  background: #ef4444;
}
