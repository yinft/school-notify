page {
  background: linear-gradient(180deg, #eef6ff 0%, #f8fbff 220rpx, #f4f7fb 100%);
  color: #16324f;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.stack-lg {
  margin-top: 24rpx;
}

.hero-overline {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.82;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2f80ff 0%, #5ba8ff 72%, #8fd1ff 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(47, 128, 255, 0.18);
}

.hero-card-compact {
  padding: 28rpx;
}

.hero-accent {
  position: absolute;
  right: -20rpx;
  top: -18rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  opacity: 0.18;
  transform: rotate(18deg);
}

.hero-accent-devices {
  background: linear-gradient(135deg, #ecfeff 0%, #67e8f9 100%);
}

.hero-accent-send {
  background: linear-gradient(135deg, #fef3c7 0%, #facc15 100%);
}

.hero-accent-records {
  background: linear-gradient(135deg, #ede9fe 0%, #a78bfa 100%);
}

.hero-accent-profile {
  background: linear-gradient(135deg, #d1fae5 0%, #34d399 100%);
}

.hero-accent-bind {
  background: linear-gradient(135deg, #dbeafe 0%, #93c5fd 100%);
}

.hero-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-stat {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(8rpx);
}

.hero-stat-value {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-card-devices {
  background: linear-gradient(135deg, #225fc4 0%, #3076ea 58%, #70b6ff 100%);
}

.hero-card-send {
  background: linear-gradient(135deg, #166df4 0%, #4398ff 56%, #8ac2ff 100%);
  box-shadow: 0 18rpx 40rpx rgba(22, 109, 244, 0.24);
}

.hero-card-records {
  background: linear-gradient(135deg, #4b53bf 0%, #6d75dc 58%, #9ea8ff 100%);
  box-shadow: 0 18rpx 40rpx rgba(75, 83, 191, 0.2);
}

.hero-card-profile {
  background: linear-gradient(135deg, #1e8e7f 0%, #26ab96 56%, #8fd8ca 100%);
  box-shadow: 0 18rpx 40rpx rgba(30, 142, 127, 0.18);
}

.hero-card-bind {
  background: linear-gradient(135deg, #4d8af7 0%, #83b8ff 58%, #dcebff 100%);
  box-shadow: 0 16rpx 32rpx rgba(77, 138, 247, 0.14);
}

.hero-simple-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
}

.hero-simple-main {
  flex: 1;
}

.hero-card-devices .hero-title,
.hero-card-devices .hero-subtitle,
.hero-card-devices .hero-overline,
.hero-card-records .hero-title,
.hero-card-records .hero-subtitle,
.hero-card-records .hero-overline,
.hero-card-bind .hero-title,
.hero-card-bind .hero-subtitle,
.hero-card-bind .hero-overline {
  text-align: left;
}

.hero-card-send .hero-overline,
.hero-card-send .hero-title,
.hero-card-send .hero-subtitle {
  text-align: left;
}

.hero-card-profile .hero-overline,
.hero-card-profile .hero-title,
.hero-card-profile .hero-subtitle {
  text-align: left;
}

.hero-simple-highlight {
  min-width: 150rpx;
  text-align: right;
}

.hero-simple-highlight-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-simple-highlight-label,
.hero-simple-emphasis-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-simple-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.hero-card-devices .hero-simple-chip {
  background: rgba(255, 255, 255, 0.14);
}

.hero-card-send .hero-simple-chip {
  background: rgba(13, 53, 122, 0.18);
}

.hero-card-records .hero-simple-chip {
  background: rgba(255, 255, 255, 0.12);
}

.hero-card-profile .profile-tag {
  background: rgba(13, 77, 70, 0.2);
}

.hero-card-bind .hero-simple-chip {
  background: rgba(255, 255, 255, 0.22);
  color: rgba(255, 255, 255, 0.94);
}

.hero-simple-meta-single {
  margin-top: 20rpx;
}

.hero-simple-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.hero-simple-emphasis-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-simple-emphasis-row-left {
  justify-content: flex-start;
}

.hero-send-lite-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
}

.hero-send-lite-focus {
  min-width: 160rpx;
  text-align: right;
  padding-left: 16rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.22);
}

.hero-card-records .hero-simple-emphasis-row {
  justify-content: flex-start;
  padding-top: 8rpx;
}

.hero-card-profile .profile-hero {
  align-items: flex-start;
}

.hero-card-bind .hero-simple-meta-single {
  justify-content: flex-start;
}

.hero-simple-emphasis-value {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  border: 1rpx solid #deebff;
  box-shadow: 0 10rpx 30rpx rgba(28, 77, 147, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #16324f;
}

.section-meta {
  font-size: 22rpx;
  color: #5f7996;
}

.muted {
  color: #6f88a4;
  font-size: 24rpx;
  line-height: 1.6;
}

.status-online {
  color: #0f9d76;
}

.status-offline {
  color: #d64545;
}

.button-primary,
.button-secondary,
.button-inline {
  border-radius: 18rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.button-primary {
  background: linear-gradient(135deg, #2f80ff 0%, #4d9dff 100%);
  color: #ffffff;
  padding: 24rpx;
  box-shadow: 0 14rpx 24rpx rgba(47, 128, 255, 0.2);
}

.button-secondary {
  background: #eff6ff;
  color: #2f80ff;
  border: 2rpx solid #cfe2ff;
  padding: 22rpx;
}

.button-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  background: #eff6ff;
  color: #2f80ff;
  font-size: 24rpx;
  font-weight: 600;
}

.button-disabled {
  opacity: 0.55;
}

.field-label {
  font-size: 25rpx;
  color: #58718c;
  margin-top: 24rpx;
  margin-bottom: 10rpx;
}

.field-input,
.field-picker {
  width: 100%;
  padding: 22rpx 24rpx;
  background: #f7fbff;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #16324f;
  border: 2rpx solid #d9e9ff;
}

.field-textarea {
  min-height: 220rpx;
}

.field-helper {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7a90ab;
}

.state-panel {
  padding: 34rpx 24rpx;
  border-radius: 22rpx;
  text-align: center;
  background: #f8fbff;
  border: 2rpx solid #deebff;
}

.state-panel-error {
  background: #fff4f4;
  border-color: #ffd5d5;
}

.state-icon {
  font-size: 56rpx;
  line-height: 1;
}

.state-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #16324f;
}

.state-text {
  margin-top: 8rpx;
  color: #6f88a4;
  font-size: 24rpx;
  line-height: 1.6;
}

.state-action {
  margin-top: 20rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.badge-normal {
  background: #e5f1ff;
  color: #2f80ff;
}

.badge-important {
  background: #fff1de;
  color: #f08a24;
}

.badge-urgent {
  background: #ffe4e4;
  color: #d64545;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-chip-online {
  background: #e6fbf5;
  color: #0f9d76;
}

.status-chip-offline {
  background: #fff1f1;
  color: #d64545;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.action-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
